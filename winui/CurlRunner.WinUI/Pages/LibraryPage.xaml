<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CurlRunner.WinUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CurlRunner.WinUI.Models">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Library" />

        <TabView Grid.Row="1" IsAddTabButtonVisible="False">
            <TabViewItem Header="History" IsClosable="False">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="HistorySearchBox" PlaceholderText="Search method, URL, or status" TextChanged="HistorySearchBox_TextChanged" />
                        <Button Grid.Column="1" Click="OpenHistory_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="OpenFile" /><TextBlock Text="Open" /></StackPanel>
                        </Button>
                        <Button Grid.Column="2" Click="OpenHistoryNewTab_Click" ToolTipService.ToolTip="Open in new request tab">
                            <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Add" /><TextBlock Text="New tab" /></StackPanel>
                        </Button>
                        <Button Grid.Column="3" Click="DeleteHistory_Click" ToolTipService.ToolTip="Delete selected history item"><SymbolIcon Symbol="Delete" /></Button>
                        <Button Grid.Column="4" Click="ClearHistory_Click">Clear all</Button>
                    </Grid>
                    <ListView x:Name="HistoryList" Grid.Row="1" ItemsSource="{x:Bind FilteredHistory}" DoubleTapped="HistoryList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:HistoryEntry">
                                <Grid MinHeight="48" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" /><ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="100" /><ColumnDefinition Width="145" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Method}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Url}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Status}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Elapsed}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind Timestamp}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </TabViewItem>

            <TabViewItem Header="Collections" IsClosable="False">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SurfaceBorderStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar Background="Transparent" DefaultLabelPosition="Collapsed">
                                <AppBarButton Icon="Add" Label="New collection" Click="NewCollection_Click" />
                                <AppBarButton Icon="Rename" Label="Rename collection" Click="RenameCollection_Click" />
                                <AppBarButton Icon="Delete" Label="Delete collection" Click="DeleteCollection_Click" />
                            </CommandBar>
                            <ListView x:Name="CollectionList" Grid.Row="1" SelectionChanged="CollectionList_SelectionChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                                <AppBarButton Icon="OpenFile" Label="Open" Click="OpenCollectionRequest_Click" />
                                <AppBarButton Icon="Add" Label="New tab" Click="OpenCollectionRequestNewTab_Click" />
                                <AppBarButton Icon="Rename" Label="Rename" Click="RenameCollectionRequest_Click" />
                                <AppBarButton Icon="Delete" Label="Delete" Click="DeleteCollectionRequest_Click" />
                            </CommandBar>
                            <ListView x:Name="CollectionRequestList" Grid.Row="1" ItemsSource="{x:Bind CollectionRequests}" DoubleTapped="CollectionRequestList_DoubleTapped">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:SavedRequest">
                                        <Grid MinHeight="44" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Bind Method}" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Curl}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </TabViewItem>
        </TabView>
    </Grid>
</Page>
