<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CurlRunner.WinUI.Pages.ScenariosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:CurlRunner.WinUI.Models"
    Loaded="Page_Loaded">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="170" /></Grid.RowDefinitions>
        <Grid>
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="API Scenarios" />
            <CommandBar HorizontalAlignment="Right" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Icon="Add" Label="New" Click="NewScenario_Click" />
                <AppBarButton Icon="Rename" Label="Rename" Click="RenameScenario_Click" />
                <AppBarButton Icon="Delete" Label="Delete" Click="DeleteScenario_Click" />
                <AppBarButton Icon="Save" Label="Save" Click="SaveScenario_Click" />
                <AppBarButton Icon="Import" Label="Import tabs" Click="ImportTabs_Click" />
                <AppBarSeparator />
                <AppBarToggleButton x:Name="StopOnFailButton" Icon="Stop" Label="Stop on fail" IsChecked="True" />
                <AppBarButton x:Name="StopButton" Icon="Cancel" Label="Stop" Click="Stop_Click" IsEnabled="False" />
                <AppBarButton x:Name="RunButton" Icon="Play" Label="Run" Click="Run_Click" />
                <AppBarButton x:Name="ExportButton" Icon="Download" Label="Export" IsEnabled="False">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="HTML report" Tag="html" Click="ExportReport_Click" />
                            <MenuFlyoutItem Text="CSV results" Tag="csv" Click="ExportReport_Click" />
                            <MenuFlyoutItem Text="JUnit XML" Tag="xml" Click="ExportReport_Click" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar x:Name="ScenarioInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="0.95*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Scenarios" />
                    <ListView x:Name="ScenarioList" Grid.Row="1" DisplayMemberPath="Name" SelectionChanged="ScenarioList_SelectionChanged" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="Steps" />
                        <CommandBar HorizontalAlignment="Right" Background="Transparent" DefaultLabelPosition="Collapsed">
                            <AppBarButton Icon="Add" Label="Add step" Click="AddStep_Click" />
                            <AppBarButton Icon="Copy" Label="Duplicate step" Click="DuplicateStep_Click" />
                            <AppBarButton Label="Move up" Click="MoveStepUp_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74A;" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton Label="Move down" Click="MoveStepDown_Click"><AppBarButton.Icon><FontIcon Glyph="&#xE74B;" /></AppBarButton.Icon></AppBarButton>
                            <AppBarButton Icon="Delete" Label="Delete step" Click="DeleteStep_Click" />
                        </CommandBar>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="45" /><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                        <TextBlock Text="#" /><TextBlock Grid.Column="1" Text="Group" /><TextBlock Grid.Column="2" Text="Method" />
                        <TextBlock Grid.Column="3" Text="Step" /><TextBlock Grid.Column="4" Text="Status" /><TextBlock Grid.Column="5" Text="Time" />
                    </Grid>
                    <ListView x:Name="StepList" Grid.Row="2" ItemsSource="{x:Bind StepRows}" SelectionChanged="StepList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ScenarioStepRow">
                                <Grid MinHeight="38" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="45" /><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{x:Bind Order}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Group}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Method}" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind Elapsed, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceBorderStyle}">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Step editor" />
                        <TextBox x:Name="StepNameBox" Header="Name" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <NumberBox x:Name="StepGroupBox" Header="Group" Minimum="1" Maximum="999" SpinButtonPlacementMode="Compact" Value="1" />
                            <CheckBox x:Name="StepEnabledCheck" Grid.Column="1" VerticalAlignment="Bottom" Content="Enabled" IsChecked="True" />
                        </Grid>
                        <TextBox x:Name="StepCurlBox" Header="cURL" Style="{StaticResource CodeTextBoxStyle}" MinHeight="120" />
                        <TextBox x:Name="ExtractorsBox" Header="Extractors" Style="{StaticResource CodeTextBoxStyle}" MinHeight="80" PlaceholderText="token = json:$.data.token&#x0a;request_id = header:X-Request-Id" />
                        <TextBox x:Name="AssertionsBox" Header="Assertions" Style="{StaticResource CodeTextBoxStyle}" MinHeight="90" PlaceholderText="status == 200&#x0a;body contains success&#x0a;json $.ok == true" />
                        <Button HorizontalAlignment="Right" Click="UpdateStep_Click" Style="{StaticResource AccentButtonStyle}">Update step</Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource SurfaceBorderStyle}">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock FontWeight="SemiBold" Text="Run log" />
                    <TextBlock x:Name="SummaryText" HorizontalAlignment="Right" />
                </Grid>
                <TextBox x:Name="RunLogBox" Grid.Row="1" IsReadOnly="True" Style="{StaticResource CodeTextBoxStyle}" TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</Page>
