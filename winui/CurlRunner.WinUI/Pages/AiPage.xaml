<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="CurlRunner.WinUI.Pages.AiPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Loaded="Page_Loaded">
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="AI Analysis" />
            <CommandBar HorizontalAlignment="Right" Background="Transparent" DefaultLabelPosition="Right">
                <AppBarButton Icon="Refresh" Label="Check provider" Click="RefreshStatus_Click" />
                <AppBarButton x:Name="AnalyzeButton" Icon="Message" Label="Analyze response" Click="Analyze_Click" />
            </CommandBar>
        </Grid>
        <InfoBar x:Name="AiInfoBar" Grid.Row="1" IsClosable="True" IsOpen="False" />
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Provider" />
                        <RadioButton x:Name="LocalRadio" GroupName="Provider" Content="Free Local (Ollama)" Checked="Provider_Changed" />
                        <RadioButton x:Name="BillingRadio" GroupName="Provider" Content="Billing API (OpenAI)" Checked="Provider_Changed" />
                        <TextBox x:Name="ModelBox" Header="Model" />
                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="Ollama status" />
                            <ProgressRing x:Name="ProviderProgress" HorizontalAlignment="Right" Width="18" Height="18" IsActive="False" />
                        </Grid>
                        <TextBlock x:Name="CliStatusText" Text="CLI: checking" />
                        <TextBlock x:Name="ServerStatusText" Text="Server: checking" />
                        <TextBlock x:Name="ModelStatusText" Text="Model: checking" TextWrapping="Wrap" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="InstallButton" Click="Install_Click" HorizontalAlignment="Stretch">Install Ollama</Button>
                            <Button x:Name="StartButton" Grid.Column="1" Click="Start_Click" HorizontalAlignment="Stretch">Start Ollama</Button>
                        </Grid>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="PullButton" Click="Pull_Click" HorizontalAlignment="Stretch">Pull model</Button>
                            <Button Grid.Column="1" Click="OpenDownload_Click" HorizontalAlignment="Stretch">Download page</Button>
                        </Grid>
                        <TextBox x:Name="SetupLogBox" Header="Setup progress" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource SurfaceBorderStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Current response analysis" />
                    <TextBlock x:Name="ResponseContextText" Grid.Row="1" TextWrapping="Wrap" />
                    <TextBox x:Name="AnalysisBox" Grid.Row="2" IsReadOnly="True" Style="{StaticResource CodeTextBoxStyle}" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
