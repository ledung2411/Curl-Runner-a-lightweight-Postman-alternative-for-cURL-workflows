<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="CurlRunner.WinUI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <ScrollViewer>
        <StackPanel MaxWidth="760" Padding="20" HorizontalAlignment="Left" Spacing="12">
            <Grid>
                <TextBlock Style="{StaticResource PageHeaderTextStyle}" Text="Settings" />
                <Button HorizontalAlignment="Right" Click="SaveSettings_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Save" /><TextBlock Text="Save" /></StackPanel>
                </Button>
            </Grid>
            <InfoBar x:Name="SettingsInfoBar" IsClosable="True" IsOpen="False" />

            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Appearance" />
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="App theme" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Use system, light, or dark colors." />
                    </StackPanel>
                    <ComboBox
                        x:Name="ThemeCombo"
                        Grid.Column="1"
                        SelectedIndex="0"
                        SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="System" Tag="default" />
                        <ComboBoxItem Content="Light" Tag="light" />
                        <ComboBoxItem Content="Dark" Tag="dark" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Mica backdrop" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Use the native Windows backdrop in the app shell." />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="MicaToggle"
                        Grid.Column="1"
                        IsOn="True"
                        Toggled="MicaToggle_Toggled" />
                </Grid>
            </Border>

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Request defaults" />
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Verify SSL certificates" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Recommended for production requests." />
                    </StackPanel>
                    <ToggleSwitch x:Name="VerifySslDefaultToggle" Grid.Column="1" IsOn="True" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Follow redirects" />
                    <ToggleSwitch x:Name="RedirectDefaultToggle" Grid.Column="1" IsOn="True" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Auto decode response" />
                    <ToggleSwitch x:Name="AutoDecodeDefaultToggle" Grid.Column="1" IsOn="True" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Default timeout" />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Maximum wait time for each request." />
                    </StackPanel>
                    <NumberBox
                        x:Name="TimeoutDefaultBox"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="3600"
                        SpinButtonPlacementMode="Compact"
                        Value="30" />
                </Grid>
            </Border>

            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="About" />
            <Border Style="{StaticResource SurfaceBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Text="Curl Runner WinUI" />
                    <TextBlock Text="Windows App SDK 2.1.3 | Native WinUI 3" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
