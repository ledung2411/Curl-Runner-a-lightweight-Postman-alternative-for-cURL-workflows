<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CurlRunner.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Curl Runner"
            Subtitle="WinUI migration"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.Content>
                <Grid MaxWidth="760" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="GlobalSearchBox"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Search requests, scenarios, and tools"
                        QueryIcon="Find"
                        QuerySubmitted="GlobalSearchBox_QuerySubmitted"
                        TextChanged="GlobalSearchBox_TextChanged" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" FontSize="12" Text="ENV" />
                        <ComboBox
                            x:Name="EnvironmentCombo"
                            Width="128"
                            SelectionChanged="EnvironmentCombo_SelectionChanged"
                            ToolTipService.ToolTip="Active environment">
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="RootNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Requests" Icon="Send" Tag="requests" />
                <NavigationViewItem Content="Library" Icon="Library" Tag="library" />
                <NavigationViewItem Content="Environments" Icon="Globe" Tag="environments" />
                <NavigationViewItem Content="Scenarios" Icon="Play" Tag="scenarios" />
                <NavigationViewItem Content="Compare" Icon="Switch" Tag="compare" />
                <NavigationViewItem Content="Converter" Icon="Sync" Tag="converter" />
                <NavigationViewItem Content="AI Analysis" Icon="Message" Tag="ai" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
